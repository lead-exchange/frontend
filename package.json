{
  "name": "reactjs-tsdk-template",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "homepage": "https://telegram-mini-apps.github.io/reactjs-tsdk-template",
  "scripts": {
    "start": "vite",
    "start:dev": "VITE_DEV_MODE=true vite",
    "deploy": "gh-pages -d dist",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint src --report-unused-disable-directives",
    "lint:fix": "eslint src --report-unused-disable-directives --fix",
    "preview": "vite preview",
    "predeploy": "pnpm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.12",
    "@telegram-apps/sdk": "^3.11.8",
    "@telegram-apps/telegram-ui": "^2.1.13",
    "@tma.js/sdk-react": "^3.0.11",
    "@tonconnect/ui-react": "^2.3.1",
    "@twa-dev/sdk": "^7.0.0",
    "@twa-dev/types": "^7.0.0",
    "classnames": "^2.5.1",
    "eruda": "^3.0.1",
    "lucide-react": "^0.553.0",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.68.0",
    "react-router-dom": "^6.23.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^2.3.1",
    "@types/classnames": "^2.3.4",
    "@types/node": "^20.12.11",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitejs/plugin-react-swc": "^3.6.0",
    "globals": "^15.2.0",
    "typescript-eslint": "^8.46.3",
    "vite": "^5.2.11",
    "vite-tsconfig-paths": "^4.3.2"
  }
}
